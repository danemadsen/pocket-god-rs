# Copy to android/keystore.properties (never committed) to sign release builds.
#
# keyProperties: a key.properties file with storePassword, releaseAlias and releasePassword
#                (the password of the store, the alias of the key, the password of the key).
# storeFile:     the keystore holding that key (JKS or PKCS12).
keyProperties=/path/to/key.properties
storeFile=/path/to/upload-key.jks
