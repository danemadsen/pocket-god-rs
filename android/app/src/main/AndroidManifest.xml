<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- wgpu needs Vulkan or OpenGL ES 3.0. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- The tilt features read the accelerometer (crates/pg-platform/src/motion). -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- The "Vibrate" sound buzzes the phone (kSystemSoundID_Vibrate in the original). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PocketGod">

        <!-- Landscape only, like the original (UIInterfaceOrientationLandscapeRight); the
             native code handles every configuration change itself. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">

            <!-- The Rust library GameActivity loads: crates/pocket-god-android [lib] name. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="pocket_god_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
